# oram environment variables
# copy to .env and fill in values as needed
# precedence: CLI args > env vars > .env file > defaults

# audio
ORAM_SAMPLE_RATE=48000
ORAM_BLOCK_SIZE=512
ORAM_BIT_DEPTH=24
ORAM_REC_FORMAT=wav
ORAM_INPUT_DEVICE=
ORAM_OUTPUT_DEVICE=

# session
ORAM_SESSION_DIR=./oram_sessions

# backends (safe defaults: no cloud calls)
ORAM_STT_BACKEND=mock
ORAM_GENERATOR_BACKEND=mock
ORAM_LLM_BACKEND=none
ORAM_WHISPER_MODEL=base.en

# listening
ORAM_AUTO_LISTEN=false
ORAM_DEFAULT_LISTENING_ROUTE=hybrid
ORAM_DEFAULT_ENGINE=stable-audio-3-local

# engine router
ORAM_ENGINE_ROUTER_MODE=auto
ORAM_PREFERRED_PROVIDER=local
ORAM_STABLE_AUDIO_SERVICE_URL=http://127.0.0.1:8765
ORAM_STABLE_AUDIO_LOCAL_PROVIDER=stable_audio_mlx
ORAM_STABLE_AUDIO_LOCAL_MODEL=medium-mlx
ORAM_STABLE_AUDIO_DECODER=same-s
ORAM_STABLE_AUDIO_API_URL=
# force the local generation server's provider (mock keeps it working with no
# model weights); leave blank to auto-detect (mock unless MLX + weights present)
ORAM_SA3_PROVIDER=

# dashboard / daemon security
ORAM_DASHBOARD_TOKEN=
# ORAM_ALLOW_LAN=1 exposes local control paths on the LAN — use a token
ORAM_ALLOW_LAN=

# credential store: auto (default) | env | memory
ORAM_CREDENTIAL_STORE=
# comma-separated extra outbound host allowlist entries
ORAM_NETWORK_ALLOWLIST=

# engine providers (server-side only, never exposed to frontend)
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
HF_TOKEN=
FAL_KEY=
REPLICATE_API_TOKEN=
